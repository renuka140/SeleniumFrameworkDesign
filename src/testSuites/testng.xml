<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="All Test Suite" parallel="tests">

    <listeners>
            <listener class-name="rahulshettyacademy.testcomponents.Listeners"/>
    </listeners>
    <test thread-count="1" name="Submit Order Test">
    <classes>
            <class name="rahulshettyacademy.tests.SubmitOrderTest">
                <methods>
                    <include name="submitOrder"/>
                </methods>
            </class>
        </classes>
    </test>

    <test thread-count="1" name="Error Validations Test">
        <classes>
            <class name="rahulshettyacademy.tests.ErrorValidationsTest">
                <methods>
                    <include name="LoginErrorValidation"/>
                    <include name="ProductErrorValidation"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
